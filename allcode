const MEMORY_PAIRS=[
  ['CPU','Central Processing Unit'],
  ['RAM','Random Access Memory'],
  ['HTML','HyperText Markup Language'],
  ['Stack','Last in, first out']
];

function startMemoryMatch(){
  document.getElementById('screen-select').classList.add('hidden');
  document.getElementById('screen-memory').classList.remove('hidden');
  resetMemoryMatch();
}

function resetMemoryMatch(){
  if(memoryTimeout) clearTimeout(memoryTimeout);
  memoryTimeout=null;
  memoryOpen=[];
  memoryMatches=0;
  memoryMoves=0;
  memoryLock=false;
  memoryDeck=MEMORY_PAIRS.flatMap((pair,pairId)=>pair.map((text,side)=>({text,pairId,side,matched:false})));
  for(let i=memoryDeck.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [memoryDeck[i],memoryDeck[j]]=[memoryDeck[j],memoryDeck[i]];
  }
  renderMemoryCards();
  document.getElementById('memoryStatus').textContent='Find all four pairs!';
}

let memoryTimeout=null;

function renderMemoryCards(){
  const board=document.getElementById('memoryBoard');
  board.replaceChildren();
  memoryDeck.forEach((card,index)=>{
    const button=document.createElement('button');
    button.type='button';
    button.className='memory-card';
    button.textContent=card.matched||memoryOpen.includes(index)?card.text:'?';
    button.setAttribute('aria-label',card.matched||memoryOpen.includes(index)?`Card ${index+1}: ${card.text}`:`Card ${index+1}, hidden`);
    button.classList.toggle('revealed',memoryOpen.includes(index));
    button.classList.toggle('matched',card.matched);
    button.disabled=card.matched||memoryOpen.includes(index)||memoryLock;
    button.addEventListener('click',()=>flipMemoryCard(index));
    board.appendChild(button);
  });
}

function flipMemoryCard(index){
  if(memoryLock||memoryDeck[index].matched||memoryOpen.includes(index)) return;
  memoryOpen.push(index);
  if(memoryOpen.length<2){
    renderMemoryCards();
    return;
  }
  memoryMoves++;
  const [first,second]=memoryOpen;
  const isMatch=memoryDeck[first].pairId===memoryDeck[second].pairId&&memoryDeck[first].side!==memoryDeck[second].side;
  if(isMatch){
    memoryDeck[first].matched=true;
    memoryDeck[second].matched=true;
    memoryMatches++;
    memoryOpen=[];
    document.getElementById('memoryStatus').textContent=memoryMatches===MEMORY_PAIRS.length?`You matched them all in ${memoryMoves} moves!`:`Great match! ${memoryMatches} of ${MEMORY_PAIRS.length} pairs found.`;
    renderMemoryCards();
    return;
  }
  memoryLock=true;
  document.getElementById('memoryStatus').textContent='Not a match — remember the cards!';
  renderMemoryCards();
  memoryTimeout=setTimeout(()=>{
    memoryTimeout=null;
    memoryOpen=[];
    memoryLock=false;
    document.getElementById('memoryStatus').textContent=`${memoryMatches} of ${MEMORY_PAIRS.length} pairs found.`;
    renderMemoryCards();
  },800);
}

