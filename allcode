.wrap>section:not(#screen-select):not(.hidden) .four-board{width:min(82vw,68vh,760px);gap:clamp(5px,.8vw,10px);margin:clamp(10px,1.8vh,20px) auto;padding:clamp(8px,1.5vh,16px);}
.wrap>section:not(#screen-select):not(.hidden) .four-drop{font-size:clamp(18px,3vh,27px);}
.wrap>section:not(#screen-select):not(.hidden) .memory-board{width:min(72vw,700px);max-width:700px;gap:clamp(10px,1.5vw,18px);margin:clamp(12px,2vh,22px) auto;}
.wrap>section:not(#screen-select):not(.hidden) .memory-card{min-height:clamp(100px,18vh,180px);font-size:clamp(15px,2vh,19px);}
.wrap>section:not(#screen-select):not(.hidden) .rps-choice{width:clamp(100px,14vh,150px);height:clamp(100px,14vh,150px);font-size:clamp(42px,8vh,62px);}
.wrap>section:not(#screen-select):not(.hidden) .simon-board{grid-template-columns:repeat(2,minmax(0,min(25vh,220px)));gap:clamp(12px,2vh,20px);margin:clamp(12px,2vh,22px) auto;}
.wrap>section:not(#screen-select):not(.hidden) .whack-board{width:min(56vw,58vh,560px);max-width:560px;gap:clamp(10px,1.8vh,18px);margin:clamp(12px,2vh,22px) auto;}
.wrap>section:not(#screen-select):not(.hidden) .snake-controls{grid-template-columns:repeat(3,clamp(58px,7vh,78px));grid-template-rows:repeat(2,clamp(50px,6.5vh,68px));gap:8px;margin:clamp(8px,1.4vh,16px) auto;}
.wrap>section:not(#screen-select):not(.hidden) .snake-controls button{font-size:clamp(22px,3vh,30px);}
.wrap>section:not(#screen-select):not(.hidden) .tetris-controls{gap:clamp(8px,1vw,14px);margin:clamp(8px,1.4vh,16px) auto;}
.wrap>section:not(#screen-select):not(.hidden) .tetris-controls button{min-width:clamp(58px,7vh,78px);min-height:clamp(52px,6.5vh,68px);font-size:clamp(22px,3vh,30px);}
.wrap>section:not(#screen-select):not(.hidden) .snake-canvas{width:min(72vh,72vw,680px);height:auto;max-height:72vh;margin:clamp(8px,1.4vh,16px) auto;}
.wrap>section:not(#screen-select):not(.hidden) .pong-canvas{width:min(78vw,1000px);height:auto;max-height:68vh;margin:clamp(8px,1.4vh,16px) auto;}
.wrap>section:not(#screen-select):not(.hidden) .tetris-canvas{height:min(80vh,680px);width:auto;max-width:78vw;margin:clamp(8px,1.4vh,16px) auto;}
#screen-tetris .arcade-card{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(180px,.75fr);
  grid-template-areas:"title board" "lede board" "scores board" "status board" "controls board" "actions board";
  align-content:center;
  align-items:center;
  gap:clamp(4px,1vh,12px) clamp(10px,2vw,24px);
}
#screen-tetris .arcade-title{grid-area:title;}
#screen-tetris .arcade-lede{grid-area:lede;}
#screen-tetris .rps-scores{grid-area:scores;}
#screen-tetris #tetrisStatus{grid-area:status;}
#screen-tetris .tetris-canvas{grid-area:board;max-height:100%;margin:0 auto;}
#screen-tetris .tetris-controls{grid-area:controls;}
#screen-tetris .arcade-actions{grid-area:actions;margin-top:0;}
@media (max-width:559px) and (min-height:521px){
  #screen-tetris .arcade-card{display:block;}
  #screen-tetris .tetris-canvas{height:min(56vh,480px);max-width:100%;margin:clamp(8px,1.4vh,16px) auto;}
}
@media (max-height:520px){
  .wrap{padding-top:4px;padding-bottom:4px;}
  header{margin-bottom:3px;}
  .wrap>section:not(#screen-select):not(.hidden) .arcade-card{padding:5px;}
  .wrap>section:not(#screen-select):not(.hidden) .arcade-actions{margin-top:3px;}
  #screen-tetris .arcade-card{
    display:grid;
