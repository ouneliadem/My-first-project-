    align-content:center;
    align-items:center;
    gap:2px 12px;
  }
  #screen-tetris .arcade-title{grid-area:title;}
  #screen-tetris .arcade-title{font-size:clamp(18px,4vh,24px);}
  #screen-tetris .arcade-lede{grid-area:lede;}
  #screen-tetris .arcade-lede{font-size:12px;line-height:1.2;margin-bottom:4px !important;}
  #screen-tetris .rps-scores{grid-area:scores;}
  #screen-tetris #tetrisStatus{grid-area:status;}
  #screen-tetris .tetris-canvas{grid-area:board;height:min(78vh,400px);max-height:none;width:auto;max-width:100%;margin:0 auto;}
  #screen-tetris .tetris-controls{grid-area:controls;gap:6px;margin:4px auto;}
  #screen-tetris .tetris-controls button{min-width:48px;min-height:44px;}
  #screen-tetris .arcade-actions{grid-area:actions;margin-top:3px;}
  #screen-tetris .arcade-actions .btn{padding:8px;font-size:12px;}
  #screen-select>h1{font-size:18px;line-height:1.1;}
  #screen-select>.lede{font-size:11px;line-height:1.1;}
  #screen-select .section-tabs{margin-bottom:4px;}
  .game-card .game-description{display:none;}
  .game-card{flex-direction:row;align-items:center;gap:6px;}
  .wrap>section:not(#screen-select):not(.hidden) .arcade-actions .btn{padding:clamp(6px,1vh,10px);font-size:clamp(11px,1.8vh,14px);}
}
@media (max-width:420px){
  .wrap{padding-left:6px;padding-right:6px;}
  #gameRow{grid-template-columns:repeat(auto-fit,minmax(min(100%,105px),1fr));}
  .game-card .game-title{overflow-wrap:anywhere;}
}
@media (min-width:900px) and (min-height:600px){
  #gameRow{grid-template-columns:repeat(5,minmax(0,1fr));}
  .game-card{padding:clamp(10px,1.6vh,18px) !important;}
  .game-card .game-icon{font-size:clamp(22px,3vh,30px);}
  .game-card .game-title{font-size:clamp(14px,2vh,18px);}
  .game-card .game-description{font-size:clamp(11px,1.5vh,14px);}
}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="badge">IEEE</div>
    <div class="brandline">
      <span class="main">Student Hub</span>
      <span class="sub">Quiz Challenge · IEEE Student Branch Event</span>
    </div>
  </header>

  <section id="screen-select" style="animation:screenIn .3s ease;">
    <h1>Welcome to Student Hub</h1>
    <p class="lede">Choose a quiz to test your knowledge or head to the arcade and pick a game.</p>

    <div class="card">
      <div class="section-tabs" role="tablist" aria-label="Choose quizzes or games">
        <button class="section-tab" id="quizzesTab" type="button" role="tab" aria-selected="false" aria-controls="quizPanel">🧠 Quizzes</button>
        <button class="section-tab active" id="gamesTab" type="button" role="tab" aria-selected="true" aria-controls="gamesPanel">🎮 Games</button>
      </div>

      <div class="section-panel hidden" id="quizPanel" role="tabpanel" aria-labelledby="quizzesTab" hidden>
        <p class="section-label">Choose a quiz</p>
        <div class="diffrow" id="quizModeRow"></div>

        <div id="quizSetup">
          <p class="section-label">Track</p>
          <div class="grid" id="categoryGrid"></div>

          <p class="section-label">Difficulty</p>
          <div class="diffrow" id="diffRow"></div>
        </div>

        <button class="btn" id="quizStartBtn" type="button" disabled>Start timed quiz</button>
      </div>

      <div class="section-panel" id="gamesPanel" role="tabpanel" aria-labelledby="gamesTab">
        <p class="section-label">Pick a game</p>
        <div class="diffrow" id="gameRow"></div>

        <div id="opponentSetup" class="opponent-setup hidden">
          <p class="section-label">Who do you want to play?</p>
          <div class="diffrow">
            <button type="button" class="opponent-choice" data-opponent="computer" aria-pressed="false">Play the computer</button>
            <button type="button" class="opponent-choice" data-opponent="friend" aria-pressed="false">Play with a friend</button>
          </div>
        </div>

        <p class="section-label hidden" id="fourPlayerSetupLabel">Two players · take turns dropping discs</p>

        <button class="btn" id="gameStartBtn" type="button" disabled>Start XO Showdown</button>
      </div>
    </div>
  </section>

  <section id="screen-ttt" class="hidden" style="animation:screenIn .3s ease;">
    <div class="card ttt-card">
      <h1 class="ttt-heading">XO Showdown</h1>
      <p class="lede" id="tttDescription" style="margin-left:auto;margin-right:auto;">First to line up three wins!</p>
      <div class="ttt-scoreboard" aria-label="Match score">
        <div class="ttt-player active" id="playerXCard"><strong id="playerXName">Player X</strong><span class="ttt-score" id="scoreX">0</span></div>
        <div class="ttt-draw">Draws<br><strong id="scoreDraw">0</strong></div>
        <div class="ttt-player" id="playerOCard"><strong id="playerOName">Player O</strong><span class="ttt-score" id="scoreO">0</span></div>
      </div>
      <p class="ttt-status" id="tttStatus" role="status" aria-live="polite">Player X's turn</p>
      <div class="ttt-board" id="tttBoard" role="group" aria-label="Tic-Tac-Toe board">
        <button class="ttt-cell" type="button" data-cell="0" aria-label="Square 1, empty"></button>
        <button class="ttt-cell" type="button" data-cell="1" aria-label="Square 2, empty"></button>
        <button class="ttt-cell" type="button" data-cell="2" aria-label="Square 3, empty"></button>
        <button class="ttt-cell" type="button" data-cell="3" aria-label="Square 4, empty"></button>
        <button class="ttt-cell" type="button" data-cell="4" aria-label="Square 5, empty"></button>
        <button class="ttt-cell" type="button" data-cell="5" aria-label="Square 6, empty"></button>
        <button class="ttt-cell" type="button" data-cell="6" aria-label="Square 7, empty"></button>
        <button class="ttt-cell" type="button" data-cell="7" aria-label="Square 8, empty"></button>
        <button class="ttt-cell" type="button" data-cell="8" aria-label="Square 9, empty"></button>
      </div>
      <div class="ttt-actions">
        <button class="btn" id="newRoundBtn" type="button">New round</button>
        <button class="btn ghost" id="backToGamesBtn" type="button">Back to games</button>
      </div>
    </div>
  </section>

  <section id="screen-four" class="hidden" style="animation:screenIn .3s ease;">
    <div class="card arcade-card">
      <h1 class="arcade-title">Four in a Row</h1>
      <p class="lede arcade-lede">Take turns dropping discs. Connect four in a row to win!</p>
      <div class="ttt-scoreboard" aria-label="Match score">
        <div class="ttt-player active" id="fourRedCard"><strong>Player Red</strong><span class="ttt-score" id="fourRedScore">0</span></div>
        <div class="ttt-draw">Draws<br><strong id="fourDrawScore">0</strong></div>
        <div class="ttt-player" id="fourYellowCard"><strong>Player Yellow</strong><span class="ttt-score" id="fourYellowScore">0</span></div>
      </div>
      <p class="ttt-status" id="fourStatus" role="status" aria-live="polite">Player Red's turn</p>
      <p class="four-label">Choose a column to drop your disc.</p>
      <div class="four-board" id="fourBoard" role="group" aria-label="Four in a Row board">
        <button class="four-drop" type="button" data-column="0" aria-label="Drop in column 1">↓</button>
        <button class="four-drop" type="button" data-column="1" aria-label="Drop in column 2">↓</button>
        <button class="four-drop" type="button" data-column="2" aria-label="Drop in column 3">↓</button>
        <button class="four-drop" type="button" data-column="3" aria-label="Drop in column 4">↓</button>
        <button class="four-drop" type="button" data-column="4" aria-label="Drop in column 5">↓</button>
        <button class="four-drop" type="button" data-column="5" aria-label="Drop in column 6">↓</button>
        <button class="four-drop" type="button" data-column="6" aria-label="Drop in column 7">↓</button>
      </div>
      <div class="arcade-actions">
        <button class="btn" id="fourResetBtn" type="button">New round</button>
        <button class="btn ghost" id="fourBackBtn" type="button">Back to games</button>
      </div>
    </div>
  </section>

  <section id="screen-rps" class="hidden" style="animation:screenIn .3s ease;">
    <div class="card arcade-card">
      <h1 class="arcade-title">Rock, Paper, Scissors</h1>
      <p class="lede arcade-lede">Pick your move and see if you can beat the computer!</p>
      <div class="rps-scores">
        <div>You<strong id="rpsPlayerScore">0</strong></div>
        <div>Round<strong id="rpsRound">1 / 5</strong></div>
        <div>Computer<strong id="rpsComputerScore">0</strong></div>
      </div>
      <p class="ttt-status" id="rpsStatus" role="status" aria-live="polite">Choose your move!</p>
      <div class="rps-choices" id="rpsChoices">
        <button class="rps-choice" type="button" data-choice="rock" aria-label="Rock">✊</button>
        <button class="rps-choice" type="button" data-choice="paper" aria-label="Paper">✋</button>
        <button class="rps-choice" type="button" data-choice="scissors" aria-label="Scissors">✌️</button>
      </div>
      <div class="arcade-actions">
        <button class="btn" id="rpsResetBtn" type="button">Play again</button>
        <button class="btn ghost" id="rpsBackBtn" type="button">Back to games</button>
      </div>
    </div>
  </section>

  <section id="screen-memory" class="hidden" style="animation:screenIn .3s ease;">
    <div class="card arcade-card">
      <h1 class="arcade-title">Memory Match</h1>
      <p class="lede arcade-lede">Flip the cards and match each tech term to its meaning.</p>
      <p class="ttt-status" id="memoryStatus" role="status" aria-live="polite">Find all four pairs!</p>
      <div class="memory-board" id="memoryBoard"></div>
      <div class="arcade-actions">
        <button class="btn" id="memoryResetBtn" type="button">Shuffle cards</button>
        <button class="btn ghost" id="memoryBackBtn" type="button">Back to games</button>
      </div>
    </div>
  </section>

  <section id="screen-snake" class="hidden" style="animation:screenIn .3s ease;">
    <div class="card arcade-card">
      <h1 class="arcade-title">Snake Dash</h1>
      <p class="lede arcade-lede">Collect the glowing snacks and avoid your tail. Use arrow keys, WASD, or the touch controls.</p>
      <div class="rps-scores">
        <div>Snacks<strong id="snakeScore">0</strong></div>
        <div>Best<strong id="snakeBest">0</strong></div>
      </div>
      <p class="ttt-status" id="snakeStatus" role="status" aria-live="polite">Ready? Your snake moves right. Good luck!</p>
      <canvas class="snake-canvas" id="snakeCanvas" width="400" height="400" role="img" aria-label="Snake Dash game board"></canvas>
      <div class="snake-controls" aria-label="Snake direction controls">
        <button type="button" data-direction="up" aria-label="Move up">↑</button>
        <button type="button" data-direction="left" aria-label="Move left">←</button>
        <button type="button" data-direction="down" aria-label="Move down">↓</button>
        <button type="button" data-direction="right" aria-label="Move right">→</button>
      </div>
      <div class="arcade-actions">
        <button class="btn" id="snakeRestartBtn" type="button">Play again</button>
        <button class="btn ghost" id="snakeBackBtn" type="button">Back to games</button>
      </div>
    </div>
  </section>

  <section id="screen-tetris" class="hidden" style="animation:screenIn .3s ease;">
    <div class="card arcade-card">
      <h1 class="arcade-title">Tetris</h1>
      <p class="lede arcade-lede">Fit the falling blocks together to clear lines. Use the arrow keys or touch controls.</p>
      <div class="rps-scores">
        <div>Score<strong id="tetrisScore">0</strong></div>
        <div>Lines<strong id="tetrisLines">0</strong></div>
        <div>Best<strong id="tetrisBest">0</strong></div>
      </div>
      <p class="ttt-status" id="tetrisStatus" role="status" aria-live="polite">Ready? Start stacking!</p>
      <canvas class="tetris-canvas" id="tetrisCanvas" width="300" height="600" role="img" aria-label="Tetris game board"></canvas>
      <div class="tetris-controls" aria-label="Tetris controls">
        <button type="button" data-tetris-action="left" aria-label="Move left">←</button>
        <button type="button" data-tetris-action="rotate" aria-label="Rotate block">↻</button>
        <button type="button" data-tetris-action="right" aria-label="Move right">→</button>
        <button type="button" data-tetris-action="down" aria-label="Move down">↓</button>
        <button type="button" data-tetris-action="drop" aria-label="Drop block">⤓</button>
      </div>
      <div class="arcade-actions">
        <button class="btn" id="tetrisRestartBtn" type="button">Play again</button>
        <button class="btn ghost" id="tetrisBackBtn" type="button">Back to games</button>
      </div>
    </div>
  </section>

  <section id="screen-simon" class="hidden" style="animation:screenIn .3s ease;">
    <div class="card arcade-card">
      <h1 class="arcade-title">Simon Says</h1>
      <p class="lede arcade-lede">Watch the color pattern, then repeat it. Each round adds one more color!</p>
      <div class="rps-scores">
        <div>Level<strong id="simonLevel">0</strong></div>
        <div>Best<strong id="simonBest">0</strong></div>
      </div>
      <p class="ttt-status" id="simonStatus" role="status" aria-live="polite">Watch the pattern!</p>
      <div class="simon-board" id="simonBoard" role="group" aria-label="Simon Says color pads">
        <button class="simon-pad" type="button" data-pad="0" aria-label="Red" disabled></button>
        <button class="simon-pad" type="button" data-pad="1" aria-label="Green" disabled></button>
        <button class="simon-pad" type="button" data-pad="2" aria-label="Yellow" disabled></button>
        <button class="simon-pad" type="button" data-pad="3" aria-label="Blue" disabled></button>
      </div>
      <div class="arcade-actions">
        <button class="btn" id="simonStartBtn" type="button">Start game</button>
        <button class="btn ghost" id="simonBackBtn" type="button">Back to games</button>
      </div>
    </div>
  </section>

  <section id="screen-pong" class="hidden" style="animation:screenIn .3s ease;">
    <div class="card arcade-card">
      <h1 class="arcade-title">Neon Pong</h1>
      <p class="lede arcade-lede">Play against the computer. Move your paddle with your mouse, touch, or the up/down arrow keys. First to five wins!</p>
      <div class="rps-scores">
        <div>You<strong id="pongPlayerScore">0</strong></div>
        <div>First to 5<strong id="pongMatchLabel">PONG</strong></div>
        <div>Computer<strong id="pongComputerScore">0</strong></div>
      </div>
      <p class="ttt-status" id="pongStatus" role="status" aria-live="polite">Move your paddle to get ready!</p>
      <canvas class="pong-canvas" id="pongCanvas" width="480" height="300" role="img" aria-label="Neon Pong game. Move your paddle with the mouse, touch, or arrow keys."></canvas>
      <div class="arcade-actions">
        <button class="btn" id="pongRestartBtn" type="button">Play again</button>
        <button class="btn ghost" id="pongBackBtn" type="button">Back to games</button>
      </div>
    </div>
  </section>

  <section id="screen-whack" class="hidden" style="animation:screenIn .3s ease;">
    <div class="card arcade-card">
      <h1 class="arcade-title">Whack-a-Mole</h1>
      <p class="lede arcade-lede">Tap the mole when it pops up! How many can you catch in 30 seconds?</p>
      <div class="rps-scores">
        <div>Hits<strong id="whackScore">0</strong></div>
        <div>Time<strong id="whackTime">30</strong></div>
        <div>Best<strong id="whackBest">0</strong></div>
      </div>
      <p class="ttt-status" id="whackStatus" role="status" aria-live="polite">Press Start to play!</p>
      <div class="whack-board" id="whackBoard" role="group" aria-label="Whack-a-Mole holes">
        <button class="whack-hole" type="button" data-hole="0" aria-label="Empty hole 1" disabled></button>
        <button class="whack-hole" type="button" data-hole="1" aria-label="Empty hole 2" disabled></button>
        <button class="whack-hole" type="button" data-hole="2" aria-label="Empty hole 3" disabled></button>
        <button class="whack-hole" type="button" data-hole="3" aria-label="Empty hole 4" disabled></button>
        <button class="whack-hole" type="button" data-hole="4" aria-label="Empty hole 5" disabled></button>
        <button class="whack-hole" type="button" data-hole="5" aria-label="Empty hole 6" disabled></button>
        <button class="whack-hole" type="button" data-hole="6" aria-label="Empty hole 7" disabled></button>
        <button class="whack-hole" type="button" data-hole="7" aria-label="Empty hole 8" disabled></button>
        <button class="whack-hole" type="button" data-hole="8" aria-label="Empty hole 9" disabled></button>
      </div>
