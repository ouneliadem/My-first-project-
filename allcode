function updateFourInARowScoreboard(){
  document.getElementById('fourRedScore').textContent=fourScores.R;
  document.getElementById('fourYellowScore').textContent=fourScores.Y;
  document.getElementById('fourDrawScore').textContent=fourScores.draw;
  document.getElementById('fourRedCard').classList.toggle('active',!fourFinished&&fourCurrent==='R');
  document.getElementById('fourYellowCard').classList.toggle('active',!fourFinished&&fourCurrent==='Y');
}

function getFourInARowWinner(row,column,player){
  const directions=[[0,1],[1,0],[1,1],[1,-1]];
  for(const [rowStep,columnStep] of directions){
    const line=[{row,column}];
    for(const direction of [-1,1]){
      let nextRow=row+rowStep*direction;
      let nextColumn=column+columnStep*direction;
      while(nextRow>=0&&nextRow<FOUR_ROWS&&nextColumn>=0&&nextColumn<FOUR_COLUMNS&&fourBoard[nextRow][nextColumn]===player){
        line.push({row:nextRow,column:nextColumn});
        nextRow+=rowStep*direction;
        nextColumn+=columnStep*direction;
      }
    }
    if(line.length>=4) return line;
  }
  return null;
}

function dropFourInARowDisc(column){
  if(fourFinished||column<0||column>=FOUR_COLUMNS||fourBoard[0][column]!==null) return;
  let row=FOUR_ROWS-1;
  while(row>=0&&fourBoard[row][column]!==null) row--;
  if(row<0) return;
  fourBoard[row][column]=fourCurrent;
  const winningPositions=getFourInARowWinner(row,column,fourCurrent);
  if(winningPositions){
    fourFinished=true;
    fourScores[fourCurrent]++;
    document.getElementById('fourStatus').textContent=`Player ${fourCurrent==='R'?'Red':'Yellow'} wins! Play another round?`;
    renderFourInARowBoard(winningPositions);
  }else if(fourBoard.every(boardRow=>boardRow.every(Boolean))){
    fourFinished=true;
    fourScores.draw++;
    document.getElementById('fourStatus').textContent="It's a draw! Play another round?";
    renderFourInARowBoard();
  }else{
    fourCurrent=fourCurrent==='R'?'Y':'R';
    document.getElementById('fourStatus').textContent=`Player ${fourCurrent==='R'?'Red':'Yellow'}'s turn`;
    renderFourInARowBoard();
  }
  updateFourInARowScoreboard();
}

