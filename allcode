});

const snakeCanvas=document.getElementById('snakeCanvas');
const snakeContext=snakeCanvas.getContext('2d');
const SNAKE_CELL_SIZE=snakeCanvas.width/SNAKE_GRID_SIZE;

function startSnakeGame(){
  document.getElementById('screen-select').classList.add('hidden');
  document.getElementById('screen-snake').classList.remove('hidden');
  resetSnakeGame();
}

function placeSnakeFood(){
  const openCells=[];
  for(let y=0;y<SNAKE_GRID_SIZE;y++){
    for(let x=0;x<SNAKE_GRID_SIZE;x++){
      if(!snakeBody.some(segment=>segment.x===x&&segment.y===y)) openCells.push({x,y});
    }
  }
  if(openCells.length===0) return null;
  return openCells[Math.floor(Math.random()*openCells.length)];
}

function drawSnakeBoard(){
  snakeContext.fillStyle='#151B2E';
  snakeContext.fillRect(0,0,snakeCanvas.width,snakeCanvas.height);
  snakeContext.strokeStyle='rgba(255,255,255,.045)';
  snakeContext.lineWidth=1;
  for(let cell=0;cell<=SNAKE_GRID_SIZE;cell++){
    const position=cell*SNAKE_CELL_SIZE;
    snakeContext.beginPath();
    snakeContext.moveTo(position,0);
    snakeContext.lineTo(position,snakeCanvas.height);
    snakeContext.moveTo(0,position);
    snakeContext.lineTo(snakeCanvas.width,position);
    snakeContext.stroke();
  }
  if(snakeFood){
    snakeContext.fillStyle='#FF6682';
    snakeContext.beginPath();
    snakeContext.arc((snakeFood.x+.5)*SNAKE_CELL_SIZE,(snakeFood.y+.5)*SNAKE_CELL_SIZE,SNAKE_CELL_SIZE*.36,0,Math.PI*2);
    snakeContext.fill();
  }
  snakeBody.forEach((segment,index)=>{
    snakeContext.fillStyle=index===0?'#84F4C4':'#45C99B';
    snakeContext.beginPath();
    snakeContext.roundRect(segment.x*SNAKE_CELL_SIZE+2,segment.y*SNAKE_CELL_SIZE+2,SNAKE_CELL_SIZE-4,SNAKE_CELL_SIZE-4,5);
    snakeContext.fill();
  });
}

function resetSnakeGame(){
  if(snakeInterval) clearInterval(snakeInterval);
  snakeBody=[{x:10,y:10},{x:9,y:10},{x:8,y:10}];
  snakeDirection={x:1,y:0};
  snakeNextDirection={x:1,y:0};
  snakeScore=0;
  snakeFood=placeSnakeFood();
  snakeRunning=true;
  document.getElementById('snakeScore').textContent='0';
  document.getElementById('snakeBest').textContent=snakeBest;
  document.getElementById('snakeStatus').textContent='Use the arrow keys, WASD, or the buttons to steer.';
  snakeCanvas.setAttribute('aria-label','Snake Dash game board. Use arrow keys or direction controls.');
  drawSnakeBoard();
  snakeInterval=setInterval(moveSnake,135);
}

function setSnakeDirection(directionName){
  if(!snakeRunning) return;
  const directions={up:{x:0,y:-1},down:{x:0,y:1},left:{x:-1,y:0},right:{x:1,y:0}};
  const nextDirection=directions[directionName];
  if(!nextDirection||(nextDirection.x===-snakeDirection.x&&nextDirection.y===-snakeDirection.y)) return;
  snakeNextDirection=nextDirection;
}

function moveSnake(){
  if(!snakeRunning) return;
  snakeDirection=snakeNextDirection;
  const head={x:snakeBody[0].x+snakeDirection.x,y:snakeBody[0].y+snakeDirection.y};
  const eatsFood=snakeFood&&head.x===snakeFood.x&&head.y===snakeFood.y;
  const collisionBody=eatsFood?snakeBody:snakeBody.slice(0,-1);
  if(head.x<0||head.x>=SNAKE_GRID_SIZE||head.y<0||head.y>=SNAKE_GRID_SIZE||collisionBody.some(segment=>segment.x===head.x&&segment.y===head.y)){
    endSnakeGame(false);
    return;
  }
  snakeBody.unshift(head);
  if(eatsFood){
    snakeScore++;
    document.getElementById('snakeScore').textContent=snakeScore;
    snakeFood=placeSnakeFood();
    if(!snakeFood){
      endSnakeGame(true);
      return;
    }
  }else{
    snakeBody.pop();
  }
  drawSnakeBoard();
}

function endSnakeGame(won){
  snakeRunning=false;
  if(snakeInterval) clearInterval(snakeInterval);
  snakeInterval=null;
  snakeBest=Math.max(snakeBest,snakeScore);
  document.getElementById('snakeBest').textContent=snakeBest;
  document.getElementById('snakeStatus').textContent=won?'Amazing! You filled the whole board!':`Game over! You collected ${snakeScore} snack${snakeScore===1?'':'s'}. Tap Play again to try again.`;
  snakeCanvas.setAttribute('aria-label',`Snake Dash game over. Score: ${snakeScore}.`);
}

