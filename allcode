function renderFourInARowBoard(winningPositions=[]){
  const boardElement=document.getElementById('fourBoard');
  boardElement.querySelectorAll('.four-slot').forEach(slot=>slot.remove());
  for(let row=0;row<FOUR_ROWS;row++){
    for(let column=0;column<FOUR_COLUMNS;column++){
      const slot=document.createElement('span');
      const disc=fourBoard[row][column];
      slot.className=`four-slot${disc==='R'?' red':disc==='Y'?' yellow':''}`;
      if(winningPositions.some(position=>position.row===row&&position.column===column)) slot.classList.add('winner');
      slot.setAttribute('aria-label',`Row ${row+1}, column ${column+1}${disc?`, ${disc==='R'?'red':'yellow'} disc`:', empty'}`);
      boardElement.appendChild(slot);
    }
  }
  fourDropButtons.forEach((button,column)=>{
