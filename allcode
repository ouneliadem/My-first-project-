function startTicTacToe(){
  document.getElementById('playerXName').textContent=selOpponent==='computer'?'You (X)':'Player X';
  document.getElementById('playerOName').textContent=selOpponent==='computer'?'Computer (O)':'Player O';
  document.getElementById('tttDescription').textContent=selOpponent==='computer'?'You are X. The computer plays O. Can you beat it?':'Take turns with a friend. First to line up three wins!';
  document.getElementById('screen-select').classList.add('hidden');
  document.getElementById('screen-ttt').classList.remove('hidden');
  resetTicTacToeRound();
  tttCells[0].focus();
}

function resetTicTacToeRound(){
  if(tttAiTimeout) clearTimeout(tttAiTimeout);
  tttAiTimeout=null;
  tttBoard=Array(9).fill(null);
  tttCurrent="X";
  tttFinished=false;
  tttAiThinking=false;
  document.getElementById('tttStatus').textContent="Player X's turn";
  tttCells.forEach((cell,index)=>{
    cell.textContent='';
    cell.disabled=false;
    cell.classList.remove('mark-o','filled','win');
    cell.setAttribute('aria-label',`Square ${index+1}, empty`);
  });
  updateTicTacToeScoreboard();
}

function updateTicTacToeScoreboard(){
  document.getElementById('scoreX').textContent=tttScores.X;
  document.getElementById('scoreO').textContent=tttScores.O;
  document.getElementById('scoreDraw').textContent=tttScores.draw;
  document.getElementById('playerXCard').classList.toggle('active',!tttFinished && !tttAiThinking && tttCurrent==='X');
  document.getElementById('playerOCard').classList.toggle('active',!tttFinished && !tttAiThinking && tttCurrent==='O');
}

function playTicTacToeMove(index,isComputerMove=false){
  if(tttFinished || tttAiThinking || tttBoard[index] || (selOpponent==='computer' && tttCurrent==='O' && !isComputerMove)) return;
  tttBoard[index]=tttCurrent;
  const cell=tttCells[index];
  cell.textContent=tttCurrent;
  cell.disabled=true;
  cell.classList.add('filled');
  if(tttCurrent==='O') cell.classList.add('mark-o');
  cell.setAttribute('aria-label',`Square ${index+1}, ${tttCurrent}`);

  const winningLine=WINNING_LINES.find(line=>line.every(position=>tttBoard[position]===tttCurrent));
  if(winningLine){
    tttFinished=true;
    tttScores[tttCurrent]++;
    const winner=tttCurrent==='X'?(selOpponent==='computer'?'You':'Player X'):(selOpponent==='computer'?'The computer':'Player O');
    document.getElementById('tttStatus').textContent=`${winner} wins! Play another round?`;
    winningLine.forEach(position=>tttCells[position].classList.add('win'));
    tttCells.forEach(button=>button.disabled=true);
  }else if(tttBoard.every(Boolean)){
    tttFinished=true;
    tttScores.draw++;
    document.getElementById('tttStatus').textContent="It's a draw! Play another round?";
  }else{
    tttCurrent=tttCurrent==='X'?'O':'X';
    if(selOpponent==='computer' && tttCurrent==='O'){
      tttAiThinking=true;
      tttCells.forEach(button=>button.disabled=true);
      document.getElementById('tttStatus').textContent="Computer is thinking…";
      updateTicTacToeScoreboard();
      tttAiTimeout=setTimeout(makeComputerMove,350);
      return;
    }
    tttCells.forEach((button,position)=>button.disabled=Boolean(tttBoard[position]));
    document.getElementById('tttStatus').textContent=`Player ${tttCurrent}'s turn`;
  }
  updateTicTacToeScoreboard();
}

function findWinningLine(board,player){
  return WINNING_LINES.find(line=>line.every(position=>board[position]===player));
}

function scoreTicTacToe(board,player,depth){
  if(findWinningLine(board,'O')) return 10-depth;
  if(findWinningLine(board,'X')) return depth-10;
  if(board.every(Boolean)) return 0;
  const scores=[];
  board.forEach((value,index)=>{
    if(value) return;
    board[index]=player;
    scores.push(scoreTicTacToe(board,player==='O'?'X':'O',depth+1));
    board[index]=null;
  });
  return player==='O'?Math.max(...scores):Math.min(...scores);
}

function chooseComputerMove(){
  let bestScore=-Infinity;
  let bestMoves=[];
  tttBoard.forEach((value,index)=>{
    if(value) return;
    tttBoard[index]='O';
    const score=scoreTicTacToe(tttBoard,'X',0);
    tttBoard[index]=null;
    if(score>bestScore){bestScore=score;bestMoves=[index];}
    else if(score===bestScore) bestMoves.push(index);
  });
  return bestMoves[Math.floor(Math.random()*bestMoves.length)];
}

function makeComputerMove(){
  tttAiTimeout=null;
  if(tttFinished || selOpponent!=='computer' || tttCurrent!=='O') return;
  tttAiThinking=false;
  const move=chooseComputerMove();
  if(move!==undefined) playTicTacToeMove(move,true);
  else {
    tttFinished=true;
    tttScores.draw++;
    document.getElementById('tttStatus').textContent="It's a draw! Play another round?";
    updateTicTacToeScoreboard();
  }
}

