<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Student Hub Quiz Challenge</title>
<style>
:root{
  --bg:#F4F7FF; --bg-soft:#EEF2FF; --card:#FFFFFF; --line:#DEE5F3;
  --text:#202546; --muted:#717B9A; --accent:#635BFF; --accent-ink:#4941D4;
  --gold:#C68A1E; --teal:#139B8A; --violet:#8855D7; --rust:#E16A45;
  --correct:#1E8E55; --wrong:#B23B2E; --radius:20px;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#111526; --bg-soft:#1A2038; --card:#1A2035; --line:#303856;
    --text:#F1F1FF; --muted:#A0A9C6; --accent:#938BFF; --accent-ink:#C7C2FF;
    --gold:#E3B24A; --teal:#55C9BC; --violet:#A78BD6; --rust:#E2805C;
    --correct:#4FD08A; --wrong:#F17A6D;
    color-scheme: dark;
  }
}
*{box-sizing:border-box;}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
}
@keyframes fadeSlideUp{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
@keyframes popIn{0%{opacity:0;transform:scale(.82);}70%{transform:scale(1.05);}100%{opacity:1;transform:scale(1);}}
@keyframes screenIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
@keyframes barSheen{from{background-position:-60px 0;}to{background-position:120px 0;}}
@keyframes float{0%,100%{transform:translateY(0) rotate(-5deg);}50%{transform:translateY(-9px) rotate(5deg);}}
@keyframes glow{0%,100%{box-shadow:0 12px 30px rgba(99,91,255,.1);}50%{box-shadow:0 18px 42px rgba(99,91,255,.2);}}
@keyframes markPop{0%{opacity:0;transform:scale(.3) rotate(-18deg);}75%{transform:scale(1.16) rotate(5deg);}100%{opacity:1;transform:scale(1) rotate(0);}}
html,body{width:100%;height:100%;overflow:hidden;}
body{
  width:100vw;height:100vh;height:100dvh;overflow:hidden;margin:0;background:linear-gradient(145deg,var(--bg),color-mix(in srgb,var(--accent) 7%,var(--bg)) 55%,color-mix(in srgb,var(--teal) 8%,var(--bg)));color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;background:radial-gradient(circle at 8% 18%,color-mix(in srgb,var(--accent) 13%,transparent) 0 90px,transparent 91px),radial-gradient(circle at 92% 78%,color-mix(in srgb,var(--teal) 12%,transparent) 0 130px,transparent 131px);}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:10;}
.wrap{position:relative;width:100%;height:100%;min-height:0;max-width:1600px;margin:0 auto;padding:clamp(8px,1.5vh,18px) clamp(12px,2vw,32px);display:flex;flex-direction:column;overflow:hidden;}
header{display:flex;align-items:center;gap:10px;margin-bottom:clamp(4px,1vh,10px);flex:0 0 auto;}
.badge{
  width:clamp(34px,6vh,52px);height:clamp(34px,6vh,52px);border-radius:clamp(10px,2vh,18px);background:linear-gradient(145deg,var(--accent),var(--violet));color:#fff;
  display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;
  letter-spacing:0.5px;flex-shrink:0;border:2px solid color-mix(in srgb,var(--card) 50%,transparent);box-shadow:0 8px 20px color-mix(in srgb,var(--accent) 28%,transparent);animation:float 4s ease-in-out infinite;
}
.brandline{display:flex;flex-direction:column;}
.brandline .sub{font-size:clamp(9px,1.5vh,12px);color:var(--muted);letter-spacing:0.3px;}
.brandline .main{font-size:20px;font-weight:700;}
h1{font-size:26px;margin:0 0 6px;line-height:1.25;}
p.lede{color:var(--muted);margin:0 0 14px;font-size:clamp(12px,1.8vh,15px);max-width:56ch;line-height:1.45;}
.card{background:color-mix(in srgb,var(--card) 93%,transparent);backdrop-filter:blur(12px);border:1px solid color-mix(in srgb,var(--line) 75%,transparent);border-radius:var(--radius);padding:clamp(10px,1.5vh,20px);box-shadow:0 18px 50px rgba(37,48,100,.08);}
.section-label{font-size:12px;color:var(--muted);margin:0 0 10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:22px;}
@media (max-width:480px){.grid{grid-template-columns:1fr;}}
.choice{
  border:1px solid var(--line);background:var(--bg-soft);border-radius:10px;padding:14px 16px;
  cursor:pointer;font-size:15px;color:var(--text);text-align:left;
  transition:border-color .15s, background .15s, transform .08s ease;
  display:flex;align-items:center;gap:10px;
}
.choice:hover{border-color:var(--accent);transform:translateY(-2px);}
.choice:active{transform:scale(.97);}
.choice.selected{border-color:var(--accent);background:color-mix(in srgb, var(--accent) 12%, var(--bg-soft));font-weight:600;animation:popIn .25s ease;}
.choice .dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.diffrow{display:flex;gap:10px;margin-bottom:24px;}
.diffrow button{
  flex:1;padding:12px;border-radius:10px;border:1px solid var(--line);background:var(--bg-soft);
  color:var(--text);font-size:14px;cursor:pointer;font-weight:600;
  transition:transform .08s ease, border-color .15s, background .15s;
}
.diffrow button:active{transform:scale(.95);}
.diffrow button.selected{border-color:var(--accent);color:var(--accent-ink);background:color-mix(in srgb, var(--accent) 14%, var(--bg-soft));animation:popIn .25s ease;}
#gameRow{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,128px),1fr));grid-auto-rows:minmax(0,1fr);gap:clamp(5px,.8vw,10px);margin:0 0 clamp(5px,1vh,10px);min-height:0;flex:1;}
#quizModeRow{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-bottom:22px;}
.game-card{min-width:0;min-height:0;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:4px;text-align:left;border-radius:14px !important;padding:clamp(6px,1vh,12px) !important;animation:fadeSlideUp .4s ease both;}
.game-card:nth-child(2){animation-delay:.06s;}
.game-card:nth-child(3){animation-delay:.12s;}
.game-card .game-icon{font-size:clamp(16px,2.4vh,23px);line-height:1.1;}
.game-card .game-title{font-size:clamp(11px,1.8vh,14px);font-weight:800;line-height:1.15;}
.game-card .game-description{font-size:clamp(9px,1.4vh,11px);line-height:1.2;color:var(--muted);font-weight:400;}
.btn{
  width:100%;padding:15px;border-radius:14px;border:none;background:linear-gradient(110deg,var(--accent),var(--violet));color:#fff;
  font-size:16px;font-weight:700;cursor:pointer;margin-top:4px;transition:transform .15s ease, opacity .15s,filter .15s;box-shadow:0 8px 18px color-mix(in srgb,var(--accent) 20%,transparent);
}
.btn:hover:not(:disabled){filter:brightness(1.07);transform:translateY(-2px);}
.btn:active:not(:disabled){transform:scale(.98);}
.btn:disabled{opacity:.45;cursor:not-allowed;}
.btn.ghost{background:transparent;border:1px solid var(--line);color:var(--text);}
.hidden{display:none !important;}
.progress-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;font-size:13px;color:var(--muted);}
.quiz-track{margin-bottom:10px;}
.timer{font-variant-numeric:tabular-nums;font-weight:700;color:var(--accent-ink);}
.timer.warning{color:var(--wrong);}
.bar{height:6px;background:var(--line);border-radius:4px;overflow:hidden;margin-bottom:22px;}
.bar > div{height:100%;background:var(--accent);background-image:linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent);background-size:60px 100%;transition:width .35s ease; animation:barSheen 1.2s linear infinite;}
.qtext{font-size:18px;font-weight:600;margin:0 0 18px;line-height:1.4;animation:fadeSlideUp .35s ease both;}
.options{display:flex;flex-direction:column;gap:10px;margin-bottom:22px;}
.option{
  border:1px solid var(--line);background:var(--bg-soft);border-radius:10px;padding:14px 16px;
  cursor:pointer;font-size:15px;color:var(--text);text-align:left;width:100%;
  transition:transform .08s ease, border-color .15s, background .15s;
  animation:fadeSlideUp .35s ease both;
}
.option:nth-child(2){animation-delay:.05s;}
.option:nth-child(3){animation-delay:.1s;}
.option:nth-child(4){animation-delay:.15s;}
.option:active{transform:scale(.98);}
.option.picked{border-color:var(--accent);background:color-mix(in srgb, var(--accent) 12%, var(--bg-soft));animation:popIn .2s ease;}
.score-hero{text-align:center;padding:10px 0 20px;}
.score-hero .num{font-size:56px;font-weight:800;line-height:1;color:var(--accent-ink);animation:popIn .5s ease both;}
.score-hero .outof{font-size:16px;color:var(--muted);margin-top:4px;}
.tierbadge{
  display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border-radius:999px;
  font-weight:700;font-size:13px;margin-top:12px;animation:popIn .45s ease .15s both;
}
.stats{display:flex;gap:10px;margin:18px 0 22px;}
.stat{flex:1;background:var(--bg-soft);border:1px solid var(--line);border-radius:10px;padding:14px;text-align:center;}
.stat .n{font-size:22px;font-weight:700;}
.stat .l{font-size:12px;color:var(--muted);margin-top:2px;}
.breakdown{border-top:1px solid var(--line);padding-top:16px;margin-top:4px;}
.row{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid var(--line);animation:fadeSlideUp .3s ease both;}
.row:last-child{border-bottom:none;}
.row .mark{width:20px;flex-shrink:0;font-weight:700;}
.row .mark.ok{color:var(--correct);}
.row .mark.bad{color:var(--wrong);}
.row .body .q{font-size:14px;margin-bottom:3px;}
.row .body .a{font-size:12.5px;color:var(--muted);}
.ttt-card{text-align:center;max-width:500px;margin:0 auto;}
.ttt-heading{margin:0 0 6px;font-size:26px;}
.ttt-scoreboard{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;margin:22px 0 16px;}
.ttt-player{background:var(--bg-soft);border:1px solid var(--line);border-radius:14px;padding:12px 8px;}
.ttt-player.active{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 13%,transparent);}
.ttt-player strong{display:block;font-size:14px;}
.ttt-player .ttt-score{display:block;margin-top:4px;font-size:24px;font-weight:800;color:var(--accent-ink);}
.ttt-draw{font-size:12px;color:var(--muted);}
.ttt-status{min-height:26px;margin:12px 0 16px;font-size:16px;font-weight:700;}
.ttt-board{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;width:min(100%,360px);margin:0 auto 20px;}
.ttt-cell{aspect-ratio:1;border:1px solid var(--line);border-radius:18px;background:var(--bg-soft);color:var(--accent);font-size:clamp(42px,12vw,76px);font-weight:800;cursor:pointer;transition:transform .15s ease,border-color .15s ease,background .15s ease,box-shadow .15s ease;animation:fadeSlideUp .3s ease both;}
.ttt-cell:nth-child(2),.ttt-cell:nth-child(5),.ttt-cell:nth-child(8){animation-delay:.04s;}
.ttt-cell:nth-child(3),.ttt-cell:nth-child(6),.ttt-cell:nth-child(9){animation-delay:.08s;}
.ttt-cell:hover:enabled{transform:translateY(-3px);border-color:var(--accent);box-shadow:0 9px 18px color-mix(in srgb,var(--accent) 14%,transparent);}
.ttt-cell:disabled{cursor:default;}
.ttt-cell.mark-o{color:var(--teal);}
.ttt-cell.filled{animation:markPop .25s ease both;}
.ttt-cell.win{background:color-mix(in srgb,var(--gold) 20%,var(--bg-soft));border-color:var(--gold);animation:popIn .35s ease;}
.ttt-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.ttt-actions .btn{margin:0;}
@media (max-width:400px){.ttt-actions{grid-template-columns:1fr;}}
.opponent-setup{margin:-4px 0 20px;animation:fadeSlideUp .25s ease both;}
.opponent-setup .diffrow{margin-bottom:0;}
.arcade-card{max-width:560px;margin:0 auto;text-align:center;}
.arcade-title{margin:0 0 6px;font-size:26px;}
.arcade-lede{margin:0 auto 18px !important;}
.arcade-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px;}
.arcade-actions .btn{margin:0;}
.rps-choices{display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin:24px 0;}
.rps-choice{width:clamp(82px,22vw,116px);height:clamp(82px,22vw,116px);border:1px solid var(--line);border-radius:24px;background:var(--bg-soft);font-size:clamp(34px,9vw,48px);cursor:pointer;transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease;animation:fadeSlideUp .3s ease both;}
.rps-choice:hover{transform:translateY(-4px) rotate(-3deg);border-color:var(--accent);box-shadow:0 10px 24px color-mix(in srgb,var(--accent) 15%,transparent);}
.rps-scores{display:flex;justify-content:center;align-items:center;gap:24px;margin:20px 0;}
.rps-scores strong{display:block;font-size:26px;color:var(--accent-ink);}
.memory-board{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;max-width:460px;margin:22px auto;}
.memory-card{min-height:84px;border:1px solid var(--line);border-radius:14px;background:var(--bg-soft);padding:10px;color:var(--text);font-size:13px;font-weight:700;cursor:pointer;transition:transform .18s ease,background .18s ease,border-color .18s ease;overflow-wrap:anywhere;animation:fadeSlideUp .3s ease both;}
.memory-card:hover:enabled{transform:translateY(-2px);border-color:var(--accent);}
.memory-card.revealed{background:color-mix(in srgb,var(--accent) 12%,var(--bg-soft));border-color:var(--accent);animation:popIn .2s ease both;}
.memory-card.matched{background:color-mix(in srgb,var(--teal) 16%,var(--bg-soft));border-color:var(--teal);cursor:default;}
@media (max-width:390px){.memory-board{gap:7px;}.memory-card{min-height:72px;padding:7px;font-size:11px;}}
@media (max-width:400px){.arcade-actions{grid-template-columns:1fr;}}
.four-board{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:clamp(4px,1.4vw,9px);width:min(100%,520px);margin:18px auto 20px;padding:clamp(8px,2.4vw,14px);border-radius:20px;background:linear-gradient(145deg,var(--accent-ink),var(--accent));box-shadow:0 12px 28px color-mix(in srgb,var(--accent) 22%,transparent);}
.four-drop{aspect-ratio:1;border:0;border-radius:50%;background:color-mix(in srgb,var(--card) 90%,transparent);color:var(--text);font-size:clamp(14px,4vw,23px);font-weight:800;cursor:pointer;transition:transform .15s ease,background .15s ease;}
.four-drop:hover:enabled{transform:translateY(-3px);background:var(--card);}
.four-drop:disabled{opacity:.42;cursor:default;}
.four-slot{aspect-ratio:1;display:grid;place-items:center;border-radius:50%;background:color-mix(in srgb,var(--bg) 95%,transparent);box-shadow:inset 0 2px 6px rgba(0,0,0,.12);}
.four-slot::after{content:"";width:78%;height:78%;border-radius:50%;background:var(--bg-soft);transition:transform .16s ease,background .16s ease;}
.four-slot.red::after{background:#FF6682;box-shadow:0 0 13px rgba(255,102,130,.28);animation:markPop .22s ease both;}
.four-slot.yellow::after{background:#FFD75E;box-shadow:0 0 13px rgba(255,215,94,.3);animation:markPop .22s ease both;}
.four-slot.winner{outline:3px solid var(--gold);outline-offset:1px;}
.four-label{font-size:12px;color:var(--muted);}
.snake-canvas{display:block;width:min(100%,400px);height:auto;margin:18px auto;border:5px solid color-mix(in srgb,var(--accent) 25%,var(--line));border-radius:18px;background:#151B2E;box-shadow:0 12px 28px color-mix(in srgb,var(--accent) 18%,transparent);touch-action:none;}
.snake-controls{display:grid;grid-template-columns:repeat(3,54px);grid-template-rows:repeat(2,48px);justify-content:center;gap:6px;margin:12px auto;}
.snake-controls button{border:1px solid var(--line);border-radius:12px;background:var(--bg-soft);color:var(--text);font-size:20px;font-weight:800;cursor:pointer;touch-action:manipulation;}
.snake-controls button:hover{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,var(--bg-soft));}
.snake-controls [data-direction="up"]{grid-column:2;grid-row:1;}
.snake-controls [data-direction="left"]{grid-column:1;grid-row:2;}
.snake-controls [data-direction="down"]{grid-column:2;grid-row:2;}
.snake-controls [data-direction="right"]{grid-column:3;grid-row:2;}
.tetris-canvas{display:block;width:min(100%,300px);height:auto;margin:18px auto;border:4px solid color-mix(in srgb,var(--accent) 25%,var(--line));border-radius:14px;background:#151B2E;box-shadow:0 12px 28px color-mix(in srgb,var(--accent) 18%,transparent);touch-action:none;}
.tetris-controls{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin:12px auto;}
.tetris-controls button{min-width:52px;min-height:46px;border:1px solid var(--line);border-radius:12px;background:var(--bg-soft);color:var(--text);font-size:18px;font-weight:800;cursor:pointer;touch-action:manipulation;}
.tetris-controls button:hover{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,var(--bg-soft));}
.simon-board{display:grid;grid-template-columns:repeat(2,minmax(0,150px));gap:12px;justify-content:center;margin:24px auto;}
.simon-pad{aspect-ratio:1;border:3px solid color-mix(in srgb,var(--card) 70%,transparent);border-radius:26px;cursor:pointer;opacity:.72;transition:opacity .12s ease,transform .12s ease,filter .12s ease;box-shadow:0 8px 18px rgba(20,25,50,.12);}
.simon-pad:hover:enabled{opacity:.9;transform:scale(1.025);}
.simon-pad:disabled{cursor:default;}
.simon-pad[data-pad="0"]{background:#FF6078;}
.simon-pad[data-pad="1"]{background:#45C99B;}
.simon-pad[data-pad="2"]{background:#F8C94E;}
.simon-pad[data-pad="3"]{background:#6688FF;}
.simon-pad.lit{opacity:1;filter:brightness(1.3);transform:scale(1.055);box-shadow:0 0 30px currentColor;}
@media (max-width:380px){.simon-board{grid-template-columns:repeat(2,minmax(0,125px));gap:9px;}}
.pong-canvas{display:block;width:min(100%,480px);height:auto;margin:18px auto;border:3px solid color-mix(in srgb,var(--accent) 25%,var(--line));border-radius:16px;background:#151B2E;touch-action:none;}
.whack-board{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;width:min(100%,390px);margin:22px auto;}
.whack-hole{aspect-ratio:1;border:0;border-radius:50%;background:radial-gradient(circle at 50% 45%,#202842 0 52%,#12182B 54%);color:transparent;font-size:clamp(35px,10vw,58px);cursor:pointer;transition:transform .12s ease,filter .12s ease;box-shadow:inset 0 5px 12px rgba(0,0,0,.24);}
.whack-hole:hover:enabled{transform:scale(1.035);}
.whack-hole.mole{color:inherit;animation:popIn .16s ease both;}
.whack-hole:disabled{cursor:default;}
.section-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:20px;padding:6px;border:1px solid var(--line);border-radius:16px;background:var(--bg-soft);}
.section-tab{min-height:48px;border:0;border-radius:12px;background:transparent;color:var(--muted);font:inherit;font-weight:800;cursor:pointer;transition:background .16s ease,color .16s ease,transform .12s ease;}
.section-tab:hover{color:var(--text);}
.section-tab.active{background:var(--card);color:var(--accent-ink);box-shadow:0 4px 12px rgba(37,48,100,.1);animation:popIn .2s ease;}
.section-panel{animation:screenIn .22s ease;}
#screen-select{display:flex;flex:1;flex-direction:column;min-height:0;overflow:hidden;}
#screen-select>h1{font-size:clamp(18px,3vh,26px);margin:0 0 2px;}
#screen-select>.lede{margin:0 0 clamp(4px,1vh,10px);}
#screen-select>.card{display:flex;flex:1;flex-direction:column;min-height:0;overflow:hidden;}
#screen-select .section-tabs{flex:0 0 auto;margin:0 0 clamp(5px,1vh,10px);padding:3px;gap:4px;}
#screen-select .section-tab{min-height:clamp(30px,5vh,42px);font-size:clamp(11px,1.8vh,14px);}
#screen-select .section-panel{display:flex;flex:1;flex-direction:column;min-height:0;overflow:hidden;}
#screen-select .section-panel.hidden{display:none !important;}
#screen-select .section-label{flex:0 0 auto;margin:0 0 5px;font-size:clamp(9px,1.5vh,11px);}
#screen-select #gamesPanel .section-label:first-child{margin-bottom:clamp(3px,.7vh,7px);}
#screen-select #gameStartBtn{flex:0 0 auto;margin:0;padding:clamp(7px,1.2vh,12px);font-size:clamp(12px,1.8vh,15px);}
#screen-select #quizPanel{overflow-y:auto;}
#screen-select .diffrow{gap:6px;margin-bottom:clamp(5px,1vh,10px);}
#screen-select .diffrow button{padding:clamp(6px,1vh,10px);font-size:clamp(11px,1.7vh,14px);}
#screen-select #gamesPanel #gameRow{overflow:hidden;}
.wrap>section:not(#screen-select):not(.hidden){flex:1;min-height:0;display:flex;align-items:center;justify-content:center;overflow:hidden;}
