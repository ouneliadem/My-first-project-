const TETRIS_COLUMNS=10, TETRIS_ROWS=20, TETRIS_CELL_SIZE=30;
const TETRIS_SHAPES=[
  {color:'#42D8D0',matrix:[[1,1,1,1]]},
  {color:'#6688FF',matrix:[[1,0,0],[1,1,1]]},
  {color:'#F4A261',matrix:[[0,0,1],[1,1,1]]},
  {color:'#F8C94E',matrix:[[1,1],[1,1]]},
  {color:'#45C99B',matrix:[[0,1,1],[1,1,0]]},
  {color:'#A78BFA',matrix:[[0,1,0],[1,1,1]]},
  {color:'#FF6682',matrix:[[1,1,0],[0,1,1]]}
];
const tetrisCanvas=document.getElementById('tetrisCanvas');
const tetrisContext=tetrisCanvas.getContext('2d');
let tetrisGrid=[], tetrisPiece=null, tetrisScore=0, tetrisLines=0, tetrisBest=0, tetrisInterval=null, tetrisRunning=false;

function startTetrisGame(){
  document.getElementById('screen-select').classList.add('hidden');
  document.getElementById('screen-tetris').classList.remove('hidden');
  resetTetrisGame();
}

function spawnTetrisPiece(){
  const shape=TETRIS_SHAPES[Math.floor(Math.random()*TETRIS_SHAPES.length)];
  tetrisPiece={matrix:shape.matrix.map(row=>row.slice()),color:shape.color,x:Math.floor((TETRIS_COLUMNS-shape.matrix[0].length)/2),y:0};
  if(collidesTetris(tetrisPiece.matrix,tetrisPiece.x,tetrisPiece.y)){
    endTetrisGame();
    return false;
  }
  return true;
}

function collidesTetris(matrix,x,y){
  return matrix.some((row,rowIndex)=>row.some((cell,columnIndex)=>{
    if(!cell) return false;
    const boardX=x+columnIndex, boardY=y+rowIndex;
    return boardX<0||boardX>=TETRIS_COLUMNS||boardY>=TETRIS_ROWS||(boardY>=0&&tetrisGrid[boardY][boardX]);
  }));
}

function drawTetrisBlock(x,y,color){
  const inset=2;
  tetrisContext.fillStyle=color;
  tetrisContext.fillRect(x*TETRIS_CELL_SIZE+inset,y*TETRIS_CELL_SIZE+inset,TETRIS_CELL_SIZE-inset*2,TETRIS_CELL_SIZE-inset*2);
  tetrisContext.fillStyle='rgba(255,255,255,.18)';
  tetrisContext.fillRect(x*TETRIS_CELL_SIZE+inset,y*TETRIS_CELL_SIZE+inset,TETRIS_CELL_SIZE-inset*2,4);
}

function drawTetrisBoard(){
  tetrisContext.fillStyle='#151B2E';
  tetrisContext.fillRect(0,0,tetrisCanvas.width,tetrisCanvas.height);
  tetrisContext.strokeStyle='rgba(255,255,255,.07)';
  tetrisContext.lineWidth=1;
  for(let row=0;row<=TETRIS_ROWS;row++){
    tetrisContext.beginPath();
    tetrisContext.moveTo(0,row*TETRIS_CELL_SIZE);
    tetrisContext.lineTo(tetrisCanvas.width,row*TETRIS_CELL_SIZE);
    tetrisContext.stroke();
  }
  for(let column=0;column<=TETRIS_COLUMNS;column++){
    tetrisContext.beginPath();
    tetrisContext.moveTo(column*TETRIS_CELL_SIZE,0);
    tetrisContext.lineTo(column*TETRIS_CELL_SIZE,tetrisCanvas.height);
    tetrisContext.stroke();
  }
  tetrisGrid.forEach((row,y)=>row.forEach((color,x)=>{if(color) drawTetrisBlock(x,y,color);}));
  if(tetrisPiece) tetrisPiece.matrix.forEach((row,y)=>row.forEach((cell,x)=>{
    if(cell&&tetrisPiece.y+y>=0) drawTetrisBlock(tetrisPiece.x+x,tetrisPiece.y+y,tetrisPiece.color);
  }));
}

function resetTetrisGame(){
  if(tetrisInterval) clearInterval(tetrisInterval);
  tetrisGrid=Array.from({length:TETRIS_ROWS},()=>Array(TETRIS_COLUMNS).fill(null));
  tetrisScore=0;
  tetrisLines=0;
  tetrisRunning=true;
  document.getElementById('tetrisScore').textContent='0';
  document.getElementById('tetrisLines').textContent='0';
  document.getElementById('tetrisBest').textContent=tetrisBest;
  document.getElementById('tetrisStatus').textContent='Use ← → to move, ↑ to rotate, ↓ to drop faster, or Space to hard drop.';
  tetrisCanvas.setAttribute('aria-label','Tetris game board. Use arrow keys or touch controls.');
  spawnTetrisPiece();
  drawTetrisBoard();
  if(tetrisRunning) tetrisInterval=setInterval(tickTetris,650);
}

function moveTetrisPiece(dx,dy){
  if(!tetrisRunning||!tetrisPiece||collidesTetris(tetrisPiece.matrix,tetrisPiece.x+dx,tetrisPiece.y+dy)) return false;
  tetrisPiece.x+=dx;
  tetrisPiece.y+=dy;
  drawTetrisBoard();
  return true;
}

function rotateTetrisPiece(){
  if(!tetrisRunning||!tetrisPiece) return;
  const matrix=tetrisPiece.matrix[0].map((_,column)=>tetrisPiece.matrix.map(row=>row[column]).reverse());
  for(const offset of [0,-1,1,-2,2]){
    if(!collidesTetris(matrix,tetrisPiece.x+offset,tetrisPiece.y)){
      tetrisPiece.matrix=matrix;
      tetrisPiece.x+=offset;
      drawTetrisBoard();
      return;
    }
  }
}

function lockTetrisPiece(){
  tetrisPiece.matrix.forEach((row,y)=>row.forEach((cell,x)=>{
    if(cell){
      const boardY=tetrisPiece.y+y;
      if(boardY<0){endTetrisGame();return;}
      tetrisGrid[boardY][tetrisPiece.x+x]=tetrisPiece.color;
    }
  }));
  if(!tetrisRunning) return;
  let cleared=0;
  tetrisGrid=tetrisGrid.filter(row=>{
    if(row.every(Boolean)){cleared++;return false;}
    return true;
  });
  while(tetrisGrid.length<TETRIS_ROWS) tetrisGrid.unshift(Array(TETRIS_COLUMNS).fill(null));
  if(cleared){
    tetrisLines+=cleared;
    tetrisScore+=[0,100,300,500,800][cleared]*Math.max(1,Math.floor(tetrisLines/10)+1);
    document.getElementById('tetrisLines').textContent=tetrisLines;
    document.getElementById('tetrisScore').textContent=tetrisScore;
    document.getElementById('tetrisStatus').textContent=`Nice! ${cleared} line${cleared===1?'':'s'} cleared.`;
    tetrisBest=Math.max(tetrisBest,tetrisScore);
    document.getElementById('tetrisBest').textContent=tetrisBest;
  }
  spawnTetrisPiece();
  drawTetrisBoard();
}

function tickTetris(){
  if(!moveTetrisPiece(0,1)) lockTetrisPiece();
}

function hardDropTetris(){
  if(!tetrisRunning||!tetrisPiece) return;
  let distance=0;
  while(!collidesTetris(tetrisPiece.matrix,tetrisPiece.x,tetrisPiece.y+1)){
    tetrisPiece.y++;
    distance++;
  }
  tetrisScore+=distance*2;
  document.getElementById('tetrisScore').textContent=tetrisScore;
  tetrisBest=Math.max(tetrisBest,tetrisScore);
  document.getElementById('tetrisBest').textContent=tetrisBest;
  lockTetrisPiece();
}

function endTetrisGame(){
  tetrisRunning=false;
  if(tetrisInterval) clearInterval(tetrisInterval);
  tetrisInterval=null;
  document.getElementById('tetrisStatus').textContent=`Game over! Final score: ${tetrisScore}. Tap Play again to restart.`;
  tetrisCanvas.setAttribute('aria-label',`Tetris game over. Score: ${tetrisScore}.`);
  drawTetrisBoard();
}

function handleTetrisAction(action){
  if(action==='left') moveTetrisPiece(-1,0);
  else if(action==='right') moveTetrisPiece(1,0);
  else if(action==='rotate') rotateTetrisPiece();
  else if(action==='down'&&moveTetrisPiece(0,1)){
    tetrisScore++;
    document.getElementById('tetrisScore').textContent=tetrisScore;
    tetrisBest=Math.max(tetrisBest,tetrisScore);
    document.getElementById('tetrisBest').textContent=tetrisBest;
  }else if(action==='drop') hardDropTetris();
}

document.addEventListener('keydown',event=>{
  if(document.getElementById('screen-tetris').classList.contains('hidden')) return;
  const actions={ArrowLeft:'left',ArrowRight:'right',ArrowUp:'rotate',ArrowDown:'down',a:'left',d:'right',w:'rotate',s:'down'};
  const action=actions[event.key]||actions[event.key.toLowerCase()];
  if(action){event.preventDefault();handleTetrisAction(action);}
  else if(event.code==='Space'){event.preventDefault();hardDropTetris();}
});
document.querySelectorAll('[data-tetris-action]').forEach(button=>button.addEventListener('click',()=>handleTetrisAction(button.dataset.tetrisAction)));
document.getElementById('tetrisRestartBtn').addEventListener('click',resetTetrisGame);
document.getElementById('tetrisBackBtn').addEventListener('click',()=>{
  if(tetrisInterval) clearInterval(tetrisInterval);
  tetrisInterval=null;
  tetrisRunning=false;
  document.getElementById('screen-tetris').classList.add('hidden');
  document.getElementById('screen-select').classList.remove('hidden');
});

const simonPads=[...document.querySelectorAll('.simon-pad')];

function startSimonGame(){
  document.getElementById('screen-select').classList.add('hidden');
  document.getElementById('screen-simon').classList.remove('hidden');
  resetSimonGame();
}

function clearSimonTimeouts(){
  simonTimeouts.forEach(timeout=>clearTimeout(timeout));
  simonTimeouts=[];
  simonPads.forEach(pad=>pad.classList.remove('lit'));
}

function resetSimonGame(){
  clearSimonTimeouts();
  simonSequence=[];
  simonInputIndex=0;
  simonLevel=0;
  simonAccepting=false;
  document.getElementById('simonLevel').textContent='0';
  document.getElementById('simonBest').textContent=simonBest;
  document.getElementById('simonStatus').textContent='Watch the pattern!';
  document.getElementById('simonStartBtn').textContent='Start game';
  simonPads.forEach(pad=>pad.disabled=true);
}

function playSimonSequence(){
  clearSimonTimeouts();
  simonAccepting=false;
  simonInputIndex=0;
  simonPads.forEach(pad=>pad.disabled=true);
  document.getElementById('simonStatus').textContent='Watch the pattern…';
  const interval=480;
  simonSequence.forEach((padIndex,position)=>{
    simonTimeouts.push(setTimeout(()=>{
      simonPads[padIndex].classList.add('lit');
    },position*interval));
    simonTimeouts.push(setTimeout(()=>{
      simonPads[padIndex].classList.remove('lit');
    },position*interval+230));
  });
  simonTimeouts.push(setTimeout(()=>{
    simonTimeouts=[];
    simonAccepting=true;
    simonPads.forEach(pad=>pad.disabled=false);
    document.getElementById('simonStatus').textContent='Your turn — repeat the pattern!';
  },simonSequence.length*interval));
}

function beginSimonSequence(){
  simonSequence.push(Math.floor(Math.random()*simonPads.length));
  document.getElementById('simonLevel').textContent=simonSequence.length;
  playSimonSequence();
}

function handleSimonPad(padIndex){
  if(!simonAccepting) return;
  const isCorrect=simonSequence[simonInputIndex]===padIndex;
  simonPads[padIndex].classList.add('lit');
  setTimeout(()=>simonPads[padIndex].classList.remove('lit'),140);
  if(!isCorrect){
    simonAccepting=false;
    simonPads.forEach(pad=>pad.disabled=true);
    simonBest=Math.max(simonBest,simonSequence.length);
    document.getElementById('simonBest').textContent=simonBest;
    document.getElementById('simonStatus').textContent=`Game over! Level ${simonSequence.length}. Press Play again to retry.`;
    document.getElementById('simonStartBtn').textContent='Play again';
    return;
  }
  simonInputIndex++;
  if(simonInputIndex===simonSequence.length){
    simonAccepting=false;
    simonBest=Math.max(simonBest,simonSequence.length);
    document.getElementById('simonBest').textContent=simonBest;
    document.getElementById('simonStatus').textContent='Great memory! Get ready for the next level…';
    simonTimeouts.push(setTimeout(beginSimonSequence,650));
  }else{
    document.getElementById('simonStatus').textContent=`Nice! ${simonInputIndex} of ${simonSequence.length}`;
  }
}

simonPads.forEach((pad,index)=>pad.addEventListener('click',()=>handleSimonPad(index)));
document.getElementById('simonStartBtn').addEventListener('click',()=>{
  resetSimonGame();
  document.getElementById('simonStartBtn').textContent='Restart game';
  beginSimonSequence();
});
document.getElementById('simonBackBtn').addEventListener('click',()=>{
  clearSimonTimeouts();
  simonAccepting=false;
  document.getElementById('screen-simon').classList.add('hidden');
  document.getElementById('screen-select').classList.remove('hidden');
});

const pongCanvas=document.getElementById('pongCanvas');
const pongContext=pongCanvas.getContext('2d');
const PONG_PADDLE_WIDTH=11, PONG_PADDLE_HEIGHT=70, PONG_BALL_RADIUS=7, PONG_WIN_SCORE=5;

function startPongGame(){
  document.getElementById('screen-select').classList.add('hidden');
  document.getElementById('screen-pong').classList.remove('hidden');
  resetPongGame();
}

function resetPongGame(){
  if(pongInterval) clearInterval(pongInterval);
  pongKeys.clear();
  pongState={
    playerY:pongCanvas.height/2-PONG_PADDLE_HEIGHT/2,
    computerY:pongCanvas.height/2-PONG_PADDLE_HEIGHT/2,
    ballX:pongCanvas.width/2,
    ballY:pongCanvas.height/2,
    velocityX:210,
    velocityY:100,
    playerScore:0,
    computerScore:0,
    running:true
  };
  updatePongScores();
  document.getElementById('pongStatus').textContent='First to five points wins. You serve!';
  drawPongBoard();
  pongInterval=setInterval(()=>stepPong(1/60),1000/60);
}

function updatePongScores(){
  document.getElementById('pongPlayerScore').textContent=pongState.playerScore;
  document.getElementById('pongComputerScore').textContent=pongState.computerScore;
}

function drawPongBoard(){
  if(!pongState) return;
  const width=pongCanvas.width, height=pongCanvas.height;
  pongContext.fillStyle='#151B2E';
  pongContext.fillRect(0,0,width,height);
  pongContext.setLineDash([8,10]);
  pongContext.strokeStyle='rgba(255,255,255,.25)';
  pongContext.lineWidth=2;
  pongContext.beginPath();
  pongContext.moveTo(width/2,12);
  pongContext.lineTo(width/2,height-12);
  pongContext.stroke();
  pongContext.setLineDash([]);
  pongContext.fillStyle='#938BFF';
  pongContext.beginPath();
  pongContext.roundRect(16,pongState.playerY,PONG_PADDLE_WIDTH,PONG_PADDLE_HEIGHT,6);
  pongContext.fill();
  pongContext.fillStyle='#45C99B';
  pongContext.beginPath();
  pongContext.roundRect(width-16-PONG_PADDLE_WIDTH,pongState.computerY,PONG_PADDLE_WIDTH,PONG_PADDLE_HEIGHT,6);
  pongContext.fill();
  pongContext.fillStyle='#FFD75E';
  pongContext.shadowColor='#FFD75E';
  pongContext.shadowBlur=14;
  pongContext.beginPath();
  pongContext.arc(pongState.ballX,pongState.ballY,PONG_BALL_RADIUS,0,Math.PI*2);
  pongContext.fill();
  pongContext.shadowBlur=0;
}

function setPongPlayerPosition(y){
  if(!pongState||!pongState.running) return;
  pongState.playerY=Math.max(0,Math.min(pongCanvas.height-PONG_PADDLE_HEIGHT,y-PONG_PADDLE_HEIGHT/2));
  drawPongBoard();
}

function scorePongPoint(winner){
  if(winner==='player') pongState.playerScore++;
  else pongState.computerScore++;
  updatePongScores();
  if(pongState.playerScore>=PONG_WIN_SCORE||pongState.computerScore>=PONG_WIN_SCORE){
    pongState.running=false;
    clearInterval(pongInterval);
    pongInterval=null;
    document.getElementById('pongStatus').textContent=pongState.playerScore>pongState.computerScore?'You win! Great rally! Press Play again for a rematch.':'Computer wins this round. Try again!';
    return;
  }
  pongState.ballX=pongCanvas.width/2;
  pongState.ballY=pongCanvas.height/2;
  pongState.velocityX=winner==='player'?-210:210;
  pongState.velocityY=(Math.random()-.5)*220;
}

function stepPong(deltaSeconds){
  if(!pongState||!pongState.running) return;
  const dt=Math.min(deltaSeconds,.04), height=pongCanvas.height, width=pongCanvas.width;
  if(pongKeys.has('ArrowUp')||pongKeys.has('w')) pongState.playerY-=300*dt;
  if(pongKeys.has('ArrowDown')||pongKeys.has('s')) pongState.playerY+=300*dt;
  pongState.playerY=Math.max(0,Math.min(height-PONG_PADDLE_HEIGHT,pongState.playerY));
  const computerTarget=pongState.ballY-PONG_PADDLE_HEIGHT/2;
  const computerDelta=computerTarget-pongState.computerY;
  pongState.computerY+=Math.max(-210*dt,Math.min(210*dt,computerDelta));
  pongState.computerY=Math.max(0,Math.min(height-PONG_PADDLE_HEIGHT,pongState.computerY));
  pongState.ballX+=pongState.velocityX*dt;
  pongState.ballY+=pongState.velocityY*dt;
  if(pongState.ballY-PONG_BALL_RADIUS<0&&pongState.velocityY<0){pongState.ballY=PONG_BALL_RADIUS;pongState.velocityY=Math.abs(pongState.velocityY);}
  if(pongState.ballY+PONG_BALL_RADIUS>height&&pongState.velocityY>0){pongState.ballY=height-PONG_BALL_RADIUS;pongState.velocityY=-Math.abs(pongState.velocityY);}
  const playerRight=16+PONG_PADDLE_WIDTH;
  if(pongState.velocityX<0&&pongState.ballX-PONG_BALL_RADIUS<=playerRight&&pongState.ballX>PONG_BALL_RADIUS&&pongState.ballY>=pongState.playerY&&pongState.ballY<=pongState.playerY+PONG_PADDLE_HEIGHT){
    pongState.ballX=playerRight+PONG_BALL_RADIUS;
    pongState.velocityX=Math.min(Math.abs(pongState.velocityX)*1.045,430);
    pongState.velocityY+=(pongState.ballY-(pongState.playerY+PONG_PADDLE_HEIGHT/2))*4;
  }
  const computerLeft=width-16-PONG_PADDLE_WIDTH;
  if(pongState.velocityX>0&&pongState.ballX+PONG_BALL_RADIUS>=computerLeft&&pongState.ballX<width-PONG_BALL_RADIUS&&pongState.ballY>=pongState.computerY&&pongState.ballY<=pongState.computerY+PONG_PADDLE_HEIGHT){
    pongState.ballX=computerLeft-PONG_BALL_RADIUS;
    pongState.velocityX=-Math.min(Math.abs(pongState.velocityX)*1.045,430);
    pongState.velocityY+=(pongState.ballY-(pongState.computerY+PONG_PADDLE_HEIGHT/2))*3.5;
  }
  if(pongState.ballX+PONG_BALL_RADIUS<0) scorePongPoint('computer');
  else if(pongState.ballX-PONG_BALL_RADIUS>width) scorePongPoint('player');
  drawPongBoard();
}

pongCanvas.addEventListener('pointermove',event=>{
  if(document.getElementById('screen-pong').classList.contains('hidden')) return;
  const bounds=pongCanvas.getBoundingClientRect();
  setPongPlayerPosition((event.clientY-bounds.top)*pongCanvas.height/bounds.height);
});
document.addEventListener('keydown',event=>{
  if(document.getElementById('screen-pong').classList.contains('hidden')) return;
  if(['ArrowUp','ArrowDown','w','W','s','S'].includes(event.key)){
    event.preventDefault();
    pongKeys.add(event.key.length===1?event.key.toLowerCase():event.key);
  }
});
document.addEventListener('keyup',event=>pongKeys.delete(event.key.length===1?event.key.toLowerCase():event.key));
document.getElementById('pongRestartBtn').addEventListener('click',resetPongGame);
document.getElementById('pongBackBtn').addEventListener('click',()=>{
  if(pongInterval) clearInterval(pongInterval);
  pongInterval=null;
  pongKeys.clear();
  if(pongState) pongState.running=false;
  document.getElementById('screen-pong').classList.add('hidden');
  document.getElementById('screen-select').classList.remove('hidden');
});

const whackHoles=[...document.querySelectorAll('.whack-hole')];

function startWhackRound(){
  clearInterval(whackTimer);
  clearInterval(whackSpawnTimer);
  whackRunning=true;
  whackScore=0;
  whackTime=30;
  whackActiveHole=-1;
  document.getElementById('whackScore').textContent=whackScore;
  document.getElementById('whackTime').textContent=whackTime;
  document.getElementById('whackBest').textContent=whackBest;
  document.getElementById('whackStatus').textContent='Go! Tap the mole!';
  whackHoles.forEach(hole=>hole.disabled=false);
  showWhackMole();
  whackSpawnTimer=setInterval(showWhackMole,680);
  whackTimer=setInterval(()=>{
    whackTime--;
    document.getElementById('whackTime').textContent=whackTime;
    if(whackTime<=0) endWhackRound();
  },1000);
}

function showWhackMole(){
  if(!whackRunning) return;
  const previous=whackActiveHole;
  let next=Math.floor(Math.random()*whackHoles.length);
  if(whackHoles.length>1) while(next===previous) next=Math.floor(Math.random()*whackHoles.length);
  whackActiveHole=next;
  whackHoles.forEach((hole,index)=>{
    const active=index===next;
    hole.classList.toggle('mole',active);
    hole.textContent=active?'🐹':'';
    hole.setAttribute('aria-label',active?`Mole in hole ${index+1}`:`Empty hole ${index+1}`);
  });
}

function hitWhackHole(index){
  if(!whackRunning||index!==whackActiveHole) return;
  whackScore++;
  whackActiveHole=-1;
  document.getElementById('whackScore').textContent=whackScore;
  document.getElementById('whackStatus').textContent=whackScore>=10?'Amazing reflexes! Keep going!':'Nice hit! Keep going!';
  whackHoles[index].classList.remove('mole');
  whackHoles[index].textContent='';
  whackHoles[index].setAttribute('aria-label',`Empty hole ${index+1}`);
}

function resetWhackGame(){
  clearInterval(whackTimer);
  clearInterval(whackSpawnTimer);
  whackTimer=null;
  whackSpawnTimer=null;
  whackRunning=false;
  whackScore=0;
  whackTime=30;
  whackActiveHole=-1;
  document.getElementById('whackScore').textContent='0';
  document.getElementById('whackTime').textContent='30';
  document.getElementById('whackBest').textContent=whackBest;
  document.getElementById('whackStatus').textContent='Press Start to play!';
  document.getElementById('whackStartBtn').textContent='Start game';
  whackHoles.forEach((hole,index)=>{
    hole.disabled=true;
    hole.classList.remove('mole');
    hole.textContent='';
    hole.setAttribute('aria-label',`Empty hole ${index+1}`);
  });
}

function endWhackRound(){
  whackRunning=false;
  whackActiveHole=-1;
  clearInterval(whackTimer);
  clearInterval(whackSpawnTimer);
  whackTimer=null;
  whackSpawnTimer=null;
  whackBest=Math.max(whackBest,whackScore);
  document.getElementById('whackBest').textContent=whackBest;
  document.getElementById('whackStatus').textContent=`Time's up! You caught ${whackScore} mole${whackScore===1?'':'s'}. Play again to beat your best!`;
  document.getElementById('whackStartBtn').textContent='Play again';
  whackHoles.forEach(hole=>{hole.disabled=true;hole.classList.remove('mole');hole.textContent='';});
}

whackHoles.forEach((hole,index)=>hole.addEventListener('click',()=>hitWhackHole(index)));
document.getElementById('whackStartBtn').addEventListener('click',startWhackRound);
document.getElementById('whackBackBtn').addEventListener('click',()=>{
  resetWhackGame();
  document.getElementById('screen-whack').classList.add('hidden');
  document.getElementById('screen-select').classList.remove('hidden');
});

function formatTime(seconds){
  const minutes=Math.floor(seconds/60);
  const remainingSeconds=seconds%60;
  return `${String(minutes).padStart(2,'0')}:${String(remainingSeconds).padStart(2,'0')}`;
}

function updateTimer(){
  if(document.getElementById('screen-quiz').classList.contains('hidden')) return;
  const secondsRemaining=Math.max(0,Math.ceil((quizDeadline-Date.now())/1000));
  const timer=document.getElementById('quizTimer');
  timer.textContent=formatTime(secondsRemaining);
  timer.setAttribute('aria-label',`Time remaining: ${Math.floor(secondsRemaining/60)} minutes ${secondsRemaining%60} seconds`);
  timer.classList.toggle('warning',secondsRemaining<=Math.min(30,Math.ceil(activeTimerDuration*0.2)));
  if(secondsRemaining===0){
    clearInterval(timerInterval);
    timerInterval=null;
    if(selMode==='rapid' && current<quiz.length-1){
      timedOutQuestions++;
      current++;
      renderQuestion();
    }else{
      timerExpired=selMode!=='rapid';
      if(selMode==='rapid') timedOutQuestions++;
      showResults();
    }
  }
}

function startTimer(duration){
  clearInterval(timerInterval);
  activeTimerDuration=duration;
  quizDeadline=Date.now()+duration*1000;
  updateTimer();
  timerInterval=setInterval(updateTimer,1000);
}

function renderQuestion(){
  const item = quiz[current];
  document.getElementById('qCounter').textContent = `Question ${current+1} of ${quiz.length}`;
  document.getElementById('progressFill').style.width = (current/quiz.length*100)+'%';
  document.getElementById('qText').textContent = item.q;
  const optWrap = document.getElementById('qOptions');
  optWrap.innerHTML='';
  item.o.forEach((opt,i)=>{
    const b=document.createElement('button');
    b.className='option'; b.type='button'; b.textContent=opt;
    b.onclick=()=>{
      answers[current]=i;
      [...optWrap.children].forEach(c=>c.classList.remove('picked'));
      b.classList.add('picked');
      document.getElementById('nextBtn').disabled=false;
    };
    if(answers[current]===i) b.classList.add('picked');
    optWrap.appendChild(b);
  });
  document.getElementById('nextBtn').disabled = answers[current]===null;
  document.getElementById('nextBtn').textContent = current===quiz.length-1 ? 'See results' : 'Next';
  if(selMode==='rapid') startTimer(RAPID_FIRE_SECONDS);
  else if(current===0) startTimer(QUIZ_DURATION_SECONDS);
}

document.getElementById('nextBtn').onclick=()=>{
  if(current<quiz.length-1){ current++; renderQuestion(); }
  else { showResults(); }
};

function showResults(){
  clearInterval(timerInterval);
  timerInterval=null;
  document.getElementById('screen-quiz').classList.add('hidden');
  document.getElementById('screen-results').classList.remove('hidden');
  const completionMessage=document.getElementById('completionMessage');
  const showTimeoutMessage=timerExpired || timedOutQuestions>0;
  completionMessage.classList.toggle('hidden',!showTimeoutMessage);
  if(timerExpired) completionMessage.textContent="Time's up. Unanswered questions were marked incorrect.";
  else if(timedOutQuestions>0) completionMessage.textContent=`Time ran out on ${timedOutQuestions} question${timedOutQuestions===1?'':'s'}. Unanswered questions were marked incorrect.`;
  let correct=0;
  quiz.forEach((item,i)=>{ if(answers[i]===item.c) correct++; });
  const wrong = quiz.length-correct;
  const pct = Math.round((correct/quiz.length)*100);
  const score20 = Math.round((correct/quiz.length)*20*10)/10;
  const numEl = document.getElementById('scoreNum');
  const startT = performance.now(); const dur=700;
  function tick(now){
    const p = Math.min(1,(now-startT)/dur);
    numEl.textContent = (Math.round(score20*p*10)/10).toFixed( (score20%1!==0) ? 1 : 0 );
    if(p<1) requestAnimationFrame(tick); else numEl.textContent = score20;
  }
  requestAnimationFrame(tick);
  document.getElementById('correctCount').textContent = correct;
  document.getElementById('wrongCount').textContent = wrong;
  document.getElementById('pctCount').textContent = pct+'%';

  const tier = document.getElementById('tierBadge');
  let label, bg, fg;
  if(pct>=85){label='🥇 Gold tier';bg='color-mix(in srgb, var(--gold) 20%, transparent)';fg='var(--gold)';}
  else if(pct>=60){label='🥈 Silver tier';bg='color-mix(in srgb, var(--teal) 20%, transparent)';fg='var(--teal)';}
  else {label='🥉 Bronze tier';bg='color-mix(in srgb, var(--rust) 20%, transparent)';fg='var(--rust)';}
  tier.textContent=label; tier.style.background=bg; tier.style.color=fg;

  const breakdown = document.getElementById('breakdown');
  breakdown.innerHTML='';
  quiz.forEach((item,i)=>{
    const ok = answers[i]===item.c;
    const row=document.createElement('div'); row.className='row';
    row.innerHTML=`<span class="mark ${ok?'ok':'bad'}">${ok?'✓':'✕'}</span>
      <div class="body"><div class="q">${item.q}</div>
      <div class="a">Your answer: ${answers[i]===null?'—':item.o[answers[i]]}${ok?'':' · Correct: '+item.o[item.c]}</div></div>`;
    breakdown.appendChild(row);
  });
}

document.getElementById('retryBtn').onclick=()=>{
  clearInterval(timerInterval);
  timerInterval=null;
  quizDeadline=0;
  timerExpired=false;
  timedOutQuestions=0;
  const timer=document.getElementById('quizTimer');
  timer.textContent=formatTime(QUIZ_DURATION_SECONDS);
  timer.setAttribute('aria-label','Time remaining: 5 minutes');
  timer.classList.remove('warning');
  document.getElementById('screen-results').classList.add('hidden');
  document.getElementById('screen-select').classList.remove('hidden');
  selCat=null; selDiff=null;
  [...categoryGrid.children].forEach(c=>c.classList.remove('selected'));
  [...diffRow.children].forEach(c=>c.classList.remove('selected'));
  checkReady();
};
</script>
