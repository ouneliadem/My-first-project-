{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start quiz web server",
            "type": "process",
            "command": "python",
            "args": ["-u", "server.py"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "quiz-server",
                "pattern": {
                    "regexp": "^(?!)((.*))$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Quiz web server starting",
                    "endsPattern": "^Quiz web server ready at http://127\\.0\\.0\\.1:8000/"
                }
            }
        }
    ]
}
